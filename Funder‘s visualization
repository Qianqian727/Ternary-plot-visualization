df['CS_n'] = df['AI_CS'] / df['sum_ai']
df['RD_n'] = df['AI_RD'] / df['sum_ai']

h = math.sqrt(3) / 2

def ternary_to_cart(ps, cs, rd):
    x = 0.5 * ps + rd
    y = h * ps
    return x, y

