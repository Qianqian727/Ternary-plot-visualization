"""
Panels A–C compare original research and funding Activity Index (AI) values.
They share the EXACT same x-axis limits and tick positions, with AI=1 reference lines.
Panel D plots Euclidean distances across the three original AI coordinates.

"""
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.ticker import FixedLocator, MultipleLocator, FormatStrFormatter

OUTDIR = Path(__file__).resolve().parent if '__file__' in globals() else Path.cwd()
PREFIX = OUTDIR / 'AI_dumbbell_2x2_revised'

# Raw Activity Index data; NOT normalized and NOT converted to RSI.
RESEARCH_DATA = [
    ('US', 1.043185, 1.040772, 0.918618),
    ('CN', 1.683414, 0.820234, 0.916757),
    ('JP', 1.006148, 0.910022, 1.133997),
    ('DE', 1.054729, 1.089260, 0.908787),
    ('IT', 0.748743, 1.091674, 0.982495),
    ('GB', 0.898743, 1.037128, 0.959161),
    ('CA', 1.047947, 1.102542, 0.872280),
    ('NL', 0.769423, 0.941968, 1.148773),
    ('FR', 0.961755, 1.115831, 0.915512),
    ('ES', 0.887030, 1.000986, 1.058671),
    ('KR', 0.739943, 1.089847, 1.102765),
    ('ZA', 0.850833, 0.596219, 1.381053),
    ('TR', 0.424317, 1.184725, 1.143777),
    ('BR', 1.090357, 0.697699, 1.238257),
    ('IN', 1.258205, 1.046800, 0.862740),
]
FUNDING_DATA = [
    ('BR', 1.0600, 0.5200, 1.2000),
    ('CA', 0.9779, 1.3034, 0.8565),
    ('CN', 1.2833, 1.0140, 0.8441),
    ('FR', 1.1500, 1.1100, 0.8400),
    ('DE', 1.3100, 0.8082, 0.8678),
    ('IN', 1.3300, 0.6100, 0.9900),
    ('IT', 1.0500, 0.8500, 0.9800),
    ('JP', 1.1499, 0.6268, 1.1010),
    ('NL', 0.6805, 1.0296, 1.1977),
    ('ZA', 0.5800, 0.5100, 1.5200),
    ('KR', 0.7013, 1.4210, 1.0602),
    ('ES', 0.9700, 0.9300, 1.0400),
    ('TR', 1.0114, 0.7409, 1.1517),
    ('GB', 0.7905, 1.2055, 1.0061),
    ('US', 1.0325, 0.9711, 0.9733),
]

# ---- Editable appearance controls -----------------------------------------
RESEARCH_COLOR = '#2F6C8F'
FUNDING_COLOR = '#C77C59'
CONNECTOR_COLOR = '#90969B'
BAR_COLOR = '#73C5A1'
BAR_EDGE = '#4C9E81'
GRID_COLOR = '#E4E7E8'
REFERENCE_COLOR = '#B5BABE'
LABEL_COLOR = '#1F2930'
TICK_COLOR = '#000000'

# Final width ~16.9 cm, close to an A4 thesis text block: avoid extra shrinking.
FIGSIZE = (6.65, 8.30)
DPI = 600
COUNTRY_FONTSIZE = 11.5
TICK_FONTSIZE = 11.5
TITLE_FONTSIZE = 12
LEGEND_FONTSIZE = 11.5
VALUE_FONTSIZE = 10.5
BAR_HEIGHT = 0.52
LABEL_DIGITS = 2

# IDENTICAL range and ticks for panels A, B and C. Includes AI=1 tick.
AI_XLIM = (0.35, 1.80)
AI_TICKS = (0.4, 0.7, 1.0, 1.3, 1.6)
# -------------------------------------------------------------------------

r = pd.DataFrame(RESEARCH_DATA,
                 columns=['country', 'research_PS', 'research_CS', 'research_RD'])
f = pd.DataFrame(FUNDING_DATA,
                 columns=['country', 'funding_PS', 'funding_CS', 'funding_RD'])
df = r.merge(f, how='inner', on='country', validate='one_to_one')
assert len(df) == 15, 'Exactly 15 matched countries expected.'

for k in ['PS', 'CS', 'RD']:
    df[f'diff_{k}'] = df[f'research_{k}'] - df[f'funding_{k}']
df['distance'] = np.sqrt(sum(df[f'diff_{k}'] ** 2 for k in ['PS', 'CS', 'RD']))
df = df.sort_values(['distance', 'country'], ascending=[False, True]).reset_index(drop=True)
assert df.country.iloc[0] == 'TR' and df.country.iloc[-1] == 'US'
df.to_csv(PREFIX.with_name(PREFIX.name + '_data.csv'), index=False)

y = np.arange(len(df))

plt.rcParams.update({
    'font.family': 'serif',
    'font.serif': ['Times New Roman', 'Tinos', 'Liberation Serif', 'DejaVu Serif'],
    'font.size': 11.5,
    'axes.titlesize': TITLE_FONTSIZE,
    'xtick.labelsize': TICK_FONTSIZE,
    'ytick.labelsize': COUNTRY_FONTSIZE,
    'pdf.fonttype': 42,
    'ps.fonttype': 42,
    'svg.fonttype': 'none',
    'figure.facecolor': 'white',
    'savefig.facecolor': 'white',
})

fig, axes = plt.subplots(2, 2, figsize=FIGSIZE, sharey=True)
fig.patch.set_facecolor('white')
flat = axes.ravel()

def style_panel(ax, show_countries=False):
    ax.set_axisbelow(True)
    ax.grid(axis='y', color=GRID_COLOR, linewidth=0.70)
    ax.grid(axis='x', visible=False)
    for side in ('top', 'right', 'left'):
        ax.spines[side].set_visible(False)
    ax.spines['bottom'].set_color('#BFC6CC')
    ax.spines['bottom'].set_linewidth(0.75)
    ax.set_yticks(y)
    ax.set_ylim(len(df) - 0.5, -0.5)  # TR on top, US at bottom
    ax.tick_params(axis='y', left=False, labelleft=show_countries, pad=4)
    ax.tick_params(axis='x', colors=TICK_COLOR, width=0.75,
                   length=3.5, pad=4, labelsize=TICK_FONTSIZE)
    if show_countries:
        ax.set_yticklabels(df['country'], fontsize=COUNTRY_FONTSIZE,
                           color=LABEL_COLOR)

# A–C: the SAME axis settings and the same country ordering.
panels = [
    (flat[0], 'PS', 'A  Physiology studies'),
    (flat[1], 'CS', 'B  Clinical studies'),
    (flat[2], 'RD', 'C  Risk factors &\ndiagnosis techniques'),
]
for ax, k, panel_title in panels:
    research = df[f'research_{k}'].to_numpy()
    funding = df[f'funding_{k}'].to_numpy()

    for j, (rv, fv) in enumerate(zip(research, funding)):
        ax.plot([rv, fv], [j, j], linewidth=1.0,
                color=CONNECTOR_COLOR, solid_capstyle='round', zorder=2)

    ax.scatter(research, y, s=32, marker='o', color=RESEARCH_COLOR,
               edgecolors='white', linewidths=0.45, zorder=4)
    ax.scatter(funding, y, s=35, marker='D', color=FUNDING_COLOR,
               edgecolors='white', linewidths=0.40, zorder=5)

    ax.axvline(1.0, color=REFERENCE_COLOR, linewidth=1.15,
               linestyle=(0, (2.6, 3)), zorder=1)
    ax.set_xlim(*AI_XLIM)
    ax.xaxis.set_major_locator(FixedLocator(AI_TICKS))
    ax.xaxis.set_major_formatter(FormatStrFormatter('%.1f'))
    ax.set_title(panel_title, loc='left', pad=11, color=LABEL_COLOR,
                 fontsize=TITLE_FONTSIZE)
    ax.set_xlabel('Activity index (AI)', labelpad=6)
    style_panel(ax, show_countries=(ax in (flat[0], flat[2])))

# D: use flat[3], NOT flat[2] (which would overwrite C).
ax = flat[3]
ax.barh(y, df['distance'], color=BAR_COLOR, edgecolor=BAR_EDGE,
        linewidth=0.5, height=BAR_HEIGHT, zorder=3)
max_dist = df['distance'].max()
ax.set_xlim(0, max_dist * 1.29)
for yi, dist in zip(y, df['distance']):
    ax.annotate(f'{dist:.{LABEL_DIGITS}f}', (dist, yi),
                xytext=(4, 0), textcoords='offset points',
                ha='left', va='center', fontsize=VALUE_FONTSIZE,
                color=LABEL_COLOR, zorder=4)
ax.set_title('D  Euclidean distance\n ', loc='left', pad=11,
             color=LABEL_COLOR, fontsize=TITLE_FONTSIZE)
ax.set_xlabel('Euclidean distance', labelpad=6)
style_panel(ax, show_countries=False)
ax.xaxis.set_major_locator(MultipleLocator(0.2))
ax.xaxis.set_major_formatter(FormatStrFormatter('%.1f'))

# Leave a dedicated lower strip for the simplified legend.
fig.subplots_adjust(left=0.120, right=0.980, top=0.940, bottom=0.135,
                    wspace=0.23, hspace=0.35)
legend = [
    Line2D([0], [0], linestyle='None', marker='o', markersize=8,
           markerfacecolor=RESEARCH_COLOR, markeredgecolor='white',
           label='Research specialisation'),
    Line2D([0], [0], linestyle='None', marker='D', markersize=8,
           markerfacecolor=FUNDING_COLOR, markeredgecolor='white',
           label='Funding specialisation'),
]
fig.legend(handles=legend, loc='lower center', ncol=2, frameon=False,
           bbox_to_anchor=(0.53, 0.025), fontsize=LEGEND_FONTSIZE,
           handletextpad=0.35, columnspacing=1.7)

for ext in ('svg'):
    fig.savefig(PREFIX.with_suffix('.' + ext),
                dpi=DPI if ext == 'png' else None,
                facecolor='white', bbox_inches='tight', pad_inches=0.07)
plt.close(fig)
