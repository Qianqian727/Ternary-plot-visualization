assert all(len(pair) == 2 for pair in pairs.values())

def build_funder_set(set_index):
    rows = []
    for country, pair in pairs.items():
        funder, ps, cs, rd = pair[set_index]
        rows.append((country, funder, ps, cs, rd))
    agencies = pd.DataFrame(rows,
        columns=['country', 'funder', 'fund_PS', 'fund_CS', 'fund_RD'])
    data = national.merge(agencies, how='inner', on='country', validate='one_to_one')
    assert len(data) == 15 and not data.isnull().any().any()
    data['country_abbr'] = data['country'].map(abbr)
    data['funder_set'] = f'Funder set {set_index+1}'
    for key in ('PS', 'CS', 'RD'):
        data[f'diff_{key}'] = data[f'nat_{key}'] - data[f'fund_{key}']
    data['distance'] = np.sqrt(sum(data[f'diff_{key}'] ** 2
                                   for key in ('PS', 'CS', 'RD')))
    return data.sort_values(['distance', 'country'],
                            ascending=[False, True]).reset_index(drop=True)

set1 = build_funder_set(0)
set2 = build_funder_set(1)
