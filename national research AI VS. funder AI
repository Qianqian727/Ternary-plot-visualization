def style_panel(ax, data):
    n = len(data)
    y = np.arange(n)
    ax.set_axisbelow(True)
    ax.grid(axis='y', color=GRID_COLOR, linewidth=0.55)
    ax.grid(axis='x', visible=False)
    for spine in ('top', 'right', 'left'):
        ax.spines[spine].set_visible(False)
    ax.spines['bottom'].set_color('#BFC6CC')
    ax.spines['bottom'].set_linewidth(0.60)
    ax.set_yticks(y)
    ax.set_yticklabels(data['country_abbr'], fontsize=COUNTRY_FONTSIZE,
                       color=LABEL_COLOR)
    ax.set_ylim(n-0.5, -0.5)
    ax.tick_params(axis='y', left=False, labelleft=True, pad=2)
    ax.tick_params(axis='x', colors=TICK_COLOR, width=0.65,
                   length=2.2, pad=2.5, labelsize=TICK_FONTSIZE)
    ax.xaxis.label.set_color(LABEL_COLOR)

def plot_dumbbell(ax, data, key, title):
    y = np.arange(len(data))
    rv = data[f'nat_{key}'].to_numpy()
    fv = data[f'fund_{key}'].to_numpy()
    for yi, a, b in zip(y, rv, fv):
        ax.plot((a,b), (yi,yi), lw=0.75, color=CONNECTOR_COLOR,
                solid_capstyle='round', zorder=2)
    ax.scatter(rv, y, s=19, marker='o', color=RESEARCH_COLOR,
               edgecolors='white', linewidths=0.25, zorder=4)
    ax.scatter(fv, y, s=23, marker='D', color=FUNDING_COLOR,
               edgecolors='white', linewidths=0.25, zorder=5)
    ax.axvline(1, color=REFERENCE_COLOR, lw=0.85,
               linestyle=(0,(2.6,3)), zorder=1)
    ax.set_xlim(AI_XLIM)
    ax.xaxis.set_major_locator(FixedLocator(AI_TICKS))
    ax.xaxis.set_major_formatter(FormatStrFormatter('%.1f'))
    style_panel(ax, data)
    ax.set_title(title, loc='left', color=LABEL_COLOR,
                 fontsize=TITLE_FONTSIZE, pad=4.0)
    ax.set_xlabel('Activity index (AI)', labelpad=3.2,
                  fontsize=AXIS_LABEL_FONTSIZE)

def plot_distance(ax, data, title):
    y = np.arange(len(data))
    ax.barh(y, data['distance'], color=BAR_COLOR, edgecolor=BAR_EDGE,
            linewidth=0.40, height=BAR_HEIGHT, zorder=3)
    ax.set_xlim(DIST_XLIM)
    ax.xaxis.set_major_locator(FixedLocator(DIST_TICKS))
    ax.xaxis.set_major_formatter(FormatStrFormatter('%.1f'))
    style_panel(ax, data)
    for yi, value in zip(y, data['distance']):
        ax.annotate(f'{value:.{LABEL_DIGITS}f}', (value, yi),
                    xytext=(2.5,0), textcoords='offset points',
                    ha='left', va='center', fontsize=VALUE_FONTSIZE,
                    color=LABEL_COLOR, zorder=4)
    ax.set_title(title, loc='left', color=LABEL_COLOR,
                 fontsize=TITLE_FONTSIZE, pad=4.0)
    ax.set_xlabel('Euclidean distance', labelpad=3.2,
                  fontsize=AXIS_LABEL_FONTSIZE)

