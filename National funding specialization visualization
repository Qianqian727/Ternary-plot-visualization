"""National funding specialisation: publication-ready ternary plot.
"""
from pathlib import Path
import math
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib import rcParams

DATA = [
    ('Brazil', 1.0600, 0.5200, 1.2000),
    ('Canada', 0.9779, 1.3034, 0.8565),
    ('China', 1.2833, 1.0140, 0.8441),
    ('France', 1.1500, 1.1100, 0.8400),
    ('Germany', 1.3100, 0.8082, 0.8678),
    ('India', 1.3300, 0.6100, 0.9900),
    ('Italy', 1.0500, 0.8500, 0.9800),
    ('Japan', 1.1499, 0.6268, 1.1010),
    ('Netherlands', 0.6805, 1.0296, 1.1977),
    ('South Africa', 0.5800, 0.5100, 1.5200),
    ('South Korea', 0.7013, 1.4210, 1.0602),
    ('Spain', 0.9700, 0.9300, 1.0400),
    ('Turkey', 1.0114, 0.7409, 1.1517),
    ('United Kingdom', 0.7905, 1.2055, 1.0061),
    ('United States', 1.0325, 0.9711, 0.9733),
]
ABBR = {
    'Brazil': 'BR', 'Canada': 'CA', 'China': 'CN', 'France': 'FR',
    'Germany': 'DE', 'India': 'IN', 'Italy': 'IT', 'Japan': 'JP',
    'Netherlands': 'NL', 'South Africa': 'ZA', 'South Korea': 'KR',
    'Spain': 'ES', 'Turkey': 'TR', 'United Kingdom': 'GB', 'United States': 'US',
}
df = pd.DataFrame(DATA, columns=['country', 'AI_PS', 'AI_CS', 'AI_RD'])
df['abbr'] = df['country'].map(ABBR)
totals = df[['AI_PS', 'AI_CS', 'AI_RD']].sum(axis=1)
df['PS'] = df['AI_PS'] / totals
df['CS'] = df['AI_CS'] / totals
df['RD'] = df['AI_RD'] / totals

H = math.sqrt(3) / 2

def xy(ps, cs, rd):
    return rd + ps / 2, H * ps

df[['x', 'y']] = df.apply(lambda r: pd.Series(xy(r.PS, r.CS, r.RD)), axis=1)
global_x, global_y = xy(1/3, 1/3, 1/3)

rcParams['font.family'] = 'serif'
rcParams['font.serif'] = ['Times New Roman', 'DejaVu Serif', 'Times']
rcParams['mathtext.fontset'] = 'dejavuserif'

C_PS = '#3C5488'
C_CS = '#00A087'
C_RD = '#E64B35'
POINT_COLOR = '#4DBBD5'
POINT_EDGE = '#2F6F85'
GLOBAL_COLOR = '#8C6D31'
GRID_COLOR = '#B0B0B0'
LEADER_COLOR = '#6A7680'

fig, a = plt.subplots(figsize=(7.9, 6.9))
for i in range(1, 10):
    t = i / 10
    segs = [
        (xy(t,1-t,0), xy(t,0,1-t)),
        (xy(1-t,t,0), xy(0,t,1-t)),
        (xy(1-t,0,t), xy(0,1-t,t)),
    ]
    for (xa,ya), (xb,yb) in segs:
        a.plot([xa,xb],[ya,yb],ls='--',lw=.8,color=GRID_COLOR,alpha=.85,zorder=0)

a.plot([0,.5], [0,H], lw=1.8, color=C_PS, zorder=1)
a.plot([.5,1], [H,0], lw=1.8, color=C_RD, zorder=1)
a.plot([0,1], [0,0], lw=1.8, color=C_CS, zorder=1)

countries = a.scatter(df.x,df.y,s=50,color=POINT_COLOR,edgecolor=POINT_EDGE,
                      linewidth=.5,zorder=3,label='Country')
world = a.scatter([global_x],[global_y],marker='*',s=120,color=GLOBAL_COLOR,
                  edgecolor=GLOBAL_COLOR,linewidth=.6,zorder=4,label='World reference')

# Direct labels, as in v3
for _,r in df.iterrows():
    if r.abbr in {'IN','BR','ZA'}:
        dx,dy = {'IN':(.012,.030),'BR':(.030,.008),'ZA':(.036,.000)}[r.abbr]
        a.text(r.x+dx,r.y+dy,r.abbr,fontsize=10.5,ha='center',va='center',zorder=5)

# Revised ES and NL locations: both below-right of their own country dots.
leader_positions = {
    'CN':(.475,.425),
    'DE':(.485,.475),
    'FR':(.432,.362),
    'CA':(.382,.318),
    'GB':(.425,.244),
    'US':(.502,.330),
    'IT':(.505,.245),
    'KR':(.466,.168),
    'ES':(.630,.230),  # right and below dot at ~(.519,.286)
    'TR':(.617,.276),
    'JP':(.665,.375),
    'NL':(.608,.152),  # right and below dot at ~(.529,.203)
}
for name,(tx,ty) in leader_positions.items():
    r = df.loc[df.abbr.eq(name)].iloc[0]
    a.annotate(name,xy=(r.x,r.y),xytext=(tx,ty),ha='center',va='center',
               fontsize=10.5,zorder=5,
               bbox=dict(facecolor='white',edgecolor='none',alpha=.75,pad=.12),
               arrowprops=dict(arrowstyle='-',lw=.75,color=LEADER_COLOR,
                               shrinkA=2,shrinkB=3))

for i in range(11):
    t = i/10
    x,y = xy(t,1-t,0)
    a.text(x-.038,y,f'{t:.1f}',color=C_PS,fontsize=14,
           ha='right',va='center',rotation=60)
    x,y = xy(1-t,0,t)
    a.text(x+.038,y,f'{t:.1f}',color=C_RD,fontsize=14,
           ha='left',va='center',rotation=-60)
    x,y = xy(0,t,1-t)
    a.text(x,y-.035,f'{t:.1f}',color=C_CS,fontsize=14,
           ha='center',va='top')

# Side arrows and text are exactly parallel (aspect equal).
# PS: double v3 length about unchanged midpoint and distance to triangle.
ps_mid=(.02 + .17/2, .28 + math.sqrt(3)*.17/2)
ps_dx=.34
ps_dy=math.sqrt(3)*ps_dx
ps_start=(ps_mid[0]-ps_dx/2,ps_mid[1]-ps_dy/2)
ps_end  =(ps_mid[0]+ps_dx/2,ps_mid[1]+ps_dy/2)
a.annotate('',xy=ps_end,xytext=ps_start,
           arrowprops=dict(arrowstyle='-|>',lw=1.35,color=C_PS,mutation_scale=10))
# The text is at arrow midpoint along the arrow, offset perpendicularly to the OUTSIDE.
ps_normal=(-math.sqrt(3)/2,.5)
ps_gap=.062
a.text(ps_mid[0]+ps_gap*ps_normal[0],ps_mid[1]+ps_gap*ps_normal[1],
       'Physiology studies',fontsize=14,color=C_PS,rotation=60,
       ha='center',va='center')

# RD: keep the doubled v3 length, center title along the arrow; offset outside.
rd_start=(.69,.75)
rd_dx=.34
rd_dy=-math.sqrt(3)*rd_dx
rd_end=(rd_start[0]+rd_dx,rd_start[1]+rd_dy)
a.annotate('',xy=rd_end,xytext=rd_start,
           arrowprops=dict(arrowstyle='-|>',lw=1.35,color=C_RD,mutation_scale=10))
rd_mid=((rd_start[0]+rd_end[0])/2,(rd_start[1]+rd_end[1])/2)
rd_normal=(math.sqrt(3)/2,.5)
rd_gap=.062
a.text(rd_mid[0]+rd_gap*rd_normal[0],rd_mid[1]+rd_gap*rd_normal[1],
       'Risk factors & diagnosis techniques',fontsize=14,color=C_RD,
       rotation=-60,ha='center',va='center')

# Bottom arrow unchanged.
a.annotate('',xy=(.18,-.08),xytext=(.82,-.08),
           arrowprops=dict(arrowstyle='-|>',lw=1.35,color=C_CS,mutation_scale=10))
a.text(.50,-.12,'Clinical studies',fontsize=16,color=C_CS,
       ha='center',va='top')

a.set_title('National funding specialisation',fontsize=16,pad=18)
a.legend(handles=[countries,world],loc='upper center',bbox_to_anchor=(.5,-.03),
         ncol=2,frameon=False,fontsize=11,handletextpad=.5,columnspacing=1.6)
a.set_aspect('equal')
a.set_xlim(-.16,1.12)
a.set_ylim(-.16,H+.08)
a.axis('off')

outdir = Path(__file__).parent if '__file__' in globals() else Path.cwd()
stem=outdir/'national_funding_specialisation_ternary_v4'
for ext in ('svg'):
    fig.savefig(str(stem)+'.'+ext,dpi=450 if ext=='png' else None,bbox_inches='tight')
print('Created:',*[str(stem)+'.'+ext for ext in ('svg')],sep='\n')
