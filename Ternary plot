import pandas as pd
import plotly.graph_objects as go
from numpy.linalg import norm

# Read data
df = pd.read_excel("data.xlsx")

# Normalize RSI values by adding an offset to make all values positive
offset = abs(min(df["RSI (Physiology)"].min(), df["RSI(CS)"].min(), df["RSI(RD)"].min())) + 0.0001
df["RSI (Physiology)"] += offset
df["RSI(CS)"] += offset
df["RSI(RD)"] += offset

# Ternary normalization
df_sum = df[["RSI (Physiology)", "RSI(CS)", "RSI(RD)"]].sum(axis=1)
df["RSI (Physiology)"] = df["RSI (Physiology)"] / df_sum
df["RSI(CS)"] = df["RSI(CS)"] / df_sum
df["RSI(RD)"] = df["RSI(RD)"] / df_sum

# Create ternary coordinates a, b, c
df["a"] = df["RSI (Physiology)"]
df["b"] = df["RSI(CS)"]
df["c"] = df["RSI(RD)"]

# Filter out overly long labels (e.g., limit to max length of 20)
df["Label"] = df["Funders"].apply(lambda x: x if len(str(x)) <= 20 else "")

# Initialize figure
fig = go.Figure()

# Add region shading
regions = {
    "A": {"a": [1.0, 2/3, 1/3, 2/3, 1.0], "b": [0.0, 1/3, 1/3, 0.0, 0.0], "c": [0.0, 0.0, 1/3, 1/3, 0.0], "color": "rgba(242, 121, 112, 0.8)", "name": "Physiology Studies"},
    "B": {"a": [2/3, 1/3, 1/3, 2/3], "b": [1/3, 2/3, 1/3, 1/3], "c": [0.0, 0.0, 1/3, 0.0], "color": "rgba(187, 151, 39, 0.8)", "name": "Physiology Studies and Clinical Studies"},
    "C": {"a": [2/3, 1/3, 1/3, 2/3], "b": [0.0, 1/3, 0.0, 0.0], "c": [1/3, 1/3, 2/3, 1/3], "color": "rgba(84, 179, 69, 0.8)", "name": "Physiology Studies and Risk Factors & Diagnosis Techniques"},
    "D": {"a": [1/3, 1/3, 0.0, 0.0, 1/3], "b": [2/3, 1/3, 2/3, 1.0, 2/3], "c": [0.0, 1/3, 1/3, 0.0, 0.0], "color": "rgba(50, 184, 151, 0.8)", "name": "Risk Factors & Diagnosis Techniques"},
    "E": {"a": [1/3, 0.0, 0.0, 1/3], "b": [1/3, 1/3, 2/3, 1/3], "c": [1/3, 2/3, 1/3, 1/3], "color": "rgba(5, 185, 226, 0.8)", "name": "Clinical Studies and Risk Factors & Diagnosis Techniques"},
    "F": {"a": [0.0, 0.0, 1/3, 1/3, 0.0], "b": [0.0, 1/3, 1/3, 0.0, 0.0], "c": [1.0, 2/3, 1/3, 2/3, 1.0], "color": "rgba(137, 131, 191, 0.8)", "name": "Clinical Studies"},
}

for region in regions.values():
    fig.add_trace(go.Scatterternary(
        a=region["a"], b=region["b"], c=region["c"],
        mode='lines', fill='toself',
        fillcolor=region["color"],
        line=dict(color='rgba(255,255,255,0)'),
        name=region["name"],
        hoverinfo='skip',
        showlegend=True
    ))

# Add region labels A-F
region_labels = {
    "A": {"text": "A", "a": 0.8, "b": 0.1, "c": 0.1},
    "B": {"text": "B", "a": 0.47, "b": 0.43, "c": 0.1},
    "C": {"text": "C", "a": 0.47, "b": 0.05, "c": 0.48},
    "D": {"text": "D", "a": 0.1, "b": 0.8, "c": 0.1},
    "E": {"text": "E", "a": 0.03, "b": 0.4, "c": 0.57},
    "F": {"text": "F", "a": 0.1, "b": 0.1, "c": 0.8},
}

for label in region_labels.values():
    fig.add_trace(go.Scatterternary(
        a=[label["a"]], b=[label["b"]], c=[label["c"]],
        mode='text', text=[label["text"]],
        textfont=dict(family="Times New Roman", size=14, color="black"),
        showlegend=False
    ))

# Add data points
fig.add_trace(go.Scatterternary(
    a=df["a"], b=df["b"], c=df["c"],
    mode='markers',
    marker=dict(size=11, color='grey'),
    showlegend=False
))

# Draw outer border
fig.add_trace(go.Scatterternary(
    a=[1, 0, 0, 1], b=[0, 1, 0, 0], c=[0, 0, 1, 0],
    mode='lines', line=dict(color='black', width=1.5), showlegend=False))

# Add dashed lines for RSI = -0.33
fig.add_trace(go.Scatterternary(
    a=[1/3, 1/3], b=[0.0, 2/3], c=[2/3, 0.0], mode='lines', line=dict(color='black', width=0.5, dash='dash'), showlegend=False))
fig.add_trace(go.Scatterternary(
    a=[0.0, 2/3], b=[1/3, 1/3], c=[2/3, 0.0], mode='lines', line=dict(color='black', width=0.5, dash='dash'), showlegend=False))
fig.add_trace(go.Scatterternary(
    a=[0.0, 2/3], b=[2/3, 0.0], c=[1/3, 1/3], mode='lines', line=dict(color='black', width=0.5, dash='dash'), showlegend=False))

# Axis and legend settings
fig.update_layout(
    ternary=dict(
        sum=1,
        aaxis=dict(title=" ", tickvals=[], ticktext=[], gridcolor='gray', gridwidth=0.5, griddash='dot'),
        baxis=dict(title=" ", tickvals=[], ticktext=[], gridcolor='gray', gridwidth=0.5, griddash='dot'),
        caxis=dict(title=" ", tickvals=[], ticktext=[], gridcolor='gray', gridwidth=0.5, griddash='dot'),
    ),
    font=dict(family="Times New Roman", size=12),
    annotations=[
        dict(text="RSI (Risk Factors & Diagnosis Techniques)", x=0.5, y=-0.1, xref="paper", yref="paper", showarrow=False, font=dict(family="Times New Roman", color="black", size=16), align='center'),
        dict(text="RSI (Clinical Studies)", x=0.15, y=0.5, xref="paper", yref="paper", showarrow=False, textangle=-60, font=dict(family="Times New Roman", color="black", size=16), align='center'),
        dict(text="RSI(Physiology Studies)", x=0.85, y=0.5, xref="paper", yref="paper", showarrow=False, textangle=60, font=dict(family="Times New Roman", color="black", size=16), align='center'),
    ],
    legend=dict(
        orientation="v", yanchor="top", y=1, xanchor="left", x=1.02,
        font=dict(size=14, color="black", family="Times New Roman"),
        bgcolor='rgba(255,255,255,0.8)', borderwidth=0)
)

# Export figure
fig.write_image("ternary_plot_highres1.png", width=800, height=600, scale=3)
fig.show()
